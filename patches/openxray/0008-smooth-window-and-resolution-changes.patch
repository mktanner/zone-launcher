+void CRenderDevice::ApplyWindowChanges()
+{
+    if (!b_is_Ready)
+        return;
+
+    if (m_toggleFullscreenPending)
+    {
+        m_toggleFullscreenPending = false;
+        const u32 style = psDeviceMode.WindowStyle;
+        const bool fullscreen = style == rsFullscreen || style == rsFullscreenBorderless;
+        if (fullscreen)
+            m_lastFullscreenStyle = style;
+        else
+            m_lastWindowedStyle = style;
+
+        // Through the console, so the setting (and rs_fullscreen) is saved like a choice in the options.
+        static constexpr pcstr names[] = { "st_opt_windowed", "st_opt_windowed_borderless",
+            "st_opt_fullscreen_borderless", "st_opt_fullscreen" };
+        string64 command;
+        xr_sprintf(command, "vid_window_mode %s", names[fullscreen ? m_lastWindowedStyle : m_lastFullscreenStyle]);
+        Console->Execute(command);
+        Reset();
+        m_windowResizePending = false;
+        return;
+    }
+
+    // The window manager resized the window (maximizing, tiling, dragging its edge), or a mode
+    // switch finished late: render at the window's size once it has stayed the same for a moment.
+    constexpr u32 settle_ms = 250;
+    int w, h;
+    SDL_GetWindowSizeInPixels(m_sdlWnd, &w, &h);
+    if (w <= 0 || h <= 0 || (w == static_cast<int>(dwWidth) && h == static_cast<int>(dwHeight)) ||
+        (SDL_GetWindowFlags(m_sdlWnd) & SDL_WINDOW_MINIMIZED))
+    {
+        m_windowResizePending = false;
+        return;
+    }
+    static Ivector2 seen{};
+    if (!m_windowResizePending || seen.x != w || seen.y != h)
+    {
+        m_windowResizePending = true;
+        m_windowResizeTime = TimerAsync();
+        seen.set(w, h);
+        return;
+    }
+    if (TimerAsync() - m_windowResizeTime < settle_ms)
+        return;
+
+    m_windowResizePending = false;
+    if ((psDeviceMode.WindowStyle == rsWindowed || psDeviceMode.WindowStyle == rsWindowedBorderless) &&
+        !(SDL_GetWindowFlags(m_sdlWnd) & SDL_WINDOW_MAXIMIZED))
+    {
+        // Back to this size when returning to a window, unless a resolution is picked meanwhile.
+        SDL_GetWindowSize(m_sdlWnd, &m_windowSize.x, &m_windowSize.y);
+        m_windowSizeFor.set(static_cast<int>(psDeviceMode.Width), static_cast<int>(psDeviceMode.Height));
+    }
+    ResetRender();
+}
