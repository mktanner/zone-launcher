@@ -327,11 +334,14 @@ DeviceState CHW::GetDeviceState() const
 
 std::pair<u32, u32> CHW::GetSurfaceSize()
 {
-    return
-    {
-        psDeviceMode.Width,
-        psDeviceMode.Height
-    };
+    // The window's real size in pixels: the window manager, borderless fullscreen and display
+    // scaling all decide it, not just the chosen resolution.
+    int width = 0, height = 0;
+    if (Device.m_sdlWnd)
+        SDL_GetWindowSizeInPixels(Device.m_sdlWnd, &width, &height);
+    if (width <= 0 || height <= 0)
+        return { psDeviceMode.Width, psDeviceMode.Height };
+    return { static_cast<u32>(width), static_cast<u32>(height) };
