+// Alt+Enter and F11 switch between fullscreen and a window. The game never sees these keys:
+// Enter would also press a menu button. A key whose press was taken has its release taken too.
+static bool IsFullscreenToggle(const SDL_KeyboardEvent& key)
+{
+    const SDL_Scancode code = key.keysym.scancode;
+    if (code == SDL_SCANCODE_F11)
+        return !(key.keysym.mod & (KMOD_CTRL | KMOD_SHIFT | KMOD_ALT | KMOD_GUI));
+    return (code == SDL_SCANCODE_RETURN || code == SDL_SCANCODE_KP_ENTER) && (key.keysym.mod & KMOD_ALT) &&
+        !(key.keysym.mod & (KMOD_CTRL | KMOD_SHIFT | KMOD_GUI));
+}
