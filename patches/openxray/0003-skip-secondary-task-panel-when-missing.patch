From: Zone Launcher
Subject: [PATCH] Skip the secondary task panel when the game has none

Pressing the objectives key (Tab) adds a "secondary_task" panel from
ui_custom_msgs.xml, which Shadow of Chernobyl does not define, so the
game aborted with "XML node not found: secondary_task". Only show it
when the node exists. It is the only custom static the engine requests
that Shadow of Chernobyl lacks.

---
diff --git a/src/xrGame/UIGameSP.cpp b/src/xrGame/UIGameSP.cpp
index 1563a41e5..56c4e8b20 100644
--- a/src/xrGame/UIGameSP.cpp
+++ b/src/xrGame/UIGameSP.cpp
@@ -157,12 +157,17 @@ bool CUIGameSP::IR_UIOnKeyboardPress(int dik)
             m_game_objective = AddCustomStatic("main_task", true);
             CGameTask* t1 = Level().GameTaskManager().ActiveTask(eTaskTypeStoryline);
             CGameTask* t2 = Level().GameTaskManager().ActiveTask(eTaskTypeAdditional);
+            // Shadow of Chernobyl's ui_custom_msgs.xml has no secondary_task panel.
+            const bool hasSecondary = MsgConfig->NavigateToNode("secondary_task", 0) != nullptr;
 
             if (t1 && t2)
             {
                 m_game_objective->m_static->SetTextST(t1->m_Title.c_str());
-                StaticDrawableWrapper* sm2 = AddCustomStatic("secondary_task", true);
-                sm2->m_static->SetTextST(t2->m_Title.c_str());
+                if (hasSecondary)
+                {
+                    StaticDrawableWrapper* sm2 = AddCustomStatic("secondary_task", true);
+                    sm2->m_static->SetTextST(t2->m_Title.c_str());
+                }
             }
             else
             {
@@ -170,8 +175,11 @@ bool CUIGameSP::IR_UIOnKeyboardPress(int dik)
                 {
                     CGameTask* t = (t1) ? t1 : t2;
                     m_game_objective->m_static->SetTextST(t->m_Title.c_str());
-                    StaticDrawableWrapper* sm2 = AddCustomStatic("secondary_task", true);
-                    sm2->m_static->TextItemControl()->SetTextST(t->m_Description.c_str());
+                    if (hasSecondary)
+                    {
+                        StaticDrawableWrapper* sm2 = AddCustomStatic("secondary_task", true);
+                        sm2->m_static->TextItemControl()->SetTextST(t->m_Description.c_str());
+                    }
                 }
                 else
                 {
