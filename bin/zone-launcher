#!/usr/bin/env python3
import os
import sys

# Installed layout keeps the package in <prefix>/share/zone-launcher; a checkout keeps it next to bin/.
here = os.path.dirname(os.path.realpath(__file__))
for candidate in (os.path.join(here, "..", "share", "zone-launcher"), os.path.join(here, "..")):
    if os.path.isdir(os.path.join(candidate, "zone_launcher")):
        sys.path.insert(0, os.path.abspath(candidate))
        break

from zone_launcher.main import main  # noqa: E402

sys.exit(main())
